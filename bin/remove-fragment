#!/bin/sh
# remove-fragment — delete a dnsmasq overlay fragment from the testbed's
# fragments volume. Pair with `render-fragment` at consumer teardown.
#
# Usage:
#   remove-fragment --name <NAME> [--priority <NN>]
#
# Required mount:
#   -v <fragments-volume>:/dst
#
# Example:
#   docker run --rm \
#     -v testbed_dnsmasq_fragments:/dst \
#     ghcr.io/rest-mail/reference-dnsmasq:VER \
#     remove-fragment --name mail1

set -eu

NAME=
PRIORITY=10

while [ $# -gt 0 ]; do
  case "$1" in
    --name)     NAME="$2"; shift 2 ;;
    --priority) PRIORITY="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "ERROR unknown arg: $1" >&2; exit 2
      ;;
  esac
done

[ -n "$NAME" ] || { echo "ERROR --name required" >&2; exit 2; }
[ -d /dst ]    || { echo "ERROR /dst not mounted" >&2; exit 2; }

PRIORITY=$(printf "%02d" "$PRIORITY")
fragment="/dst/${PRIORITY}-${NAME}.conf"

if [ -f "$fragment" ]; then
  rm -f "$fragment"
  echo "removed $fragment"
else
  echo "no fragment at $fragment (already gone)"
fi
